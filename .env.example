# MindBridge Environment Configuration
# Copy this file to .env and supply your credentials locally or configure in Vercel Project Settings.
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.

# AI Provider Credentials
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Alternative AI Providers (Leave blank if using Gemini)
HF_TOKEN=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=

# Optional External Python/FastAPI Backend Service URL
# Example: https://mindbridge-fastapi.onrender.com
BACKEND_URL=

# Server Runtime Configuration
PORT=3000
NODE_ENV=development
